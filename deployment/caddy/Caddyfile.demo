# Public demo routes and crawler protection. Common routes are in Caddyfile.shared.
{
    # Global options
    admin off
    # Email for Let's Encrypt notifications
    email {$CADDY_ACME_EMAIL}
}

import /etc/caddy/Caddyfile.shared

# Public demo application
https://{$DOMAIN} {
    # Automatic HTTPS - Caddy handles certificate issuance and renewal
    # No tls directive needed for default ACME behavior

    # This line will be uncommented by ./docker-entrypoint.sh to enable custom certificates
    # when CADDY_CERTS_HOST_PATH is set -- it should point to mount inside docker container
    # tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    # Check the per-IP cap first so rejected crawler requests do not consume
    # the shared allowance needed by other visitors.
    route {
        rate_limit {
            zone admin_per_ip {
                match {
                    path /staff-admin /staff-admin/*
                }
                key {remote_host}
                events 30
                window 1m
            }
        }
        rate_limit {
            zone admin_total {
                match {
                    path /staff-admin /staff-admin/*
                }
                key admin
                events 120
                window 1m
            }
        }
    }

    handle /robots.txt {
        root * /etc/caddy
        file_server
    }

    import app_routes
}

# File server
https://{$FILES_DOMAIN} {
    # Automatic HTTPS

    # This line will be uncommented by ./docker-entrypoint.sh to enable custom certificates
    # when CADDY_CERTS_HOST_PATH is set -- it should point to mount inside docker container
    # tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    import file_routes
}
