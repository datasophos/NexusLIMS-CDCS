# Public demo routes and crawler protection. Common routes are in Caddyfile.shared.
{
    # Global options
    admin off
    # Email for Let's Encrypt notifications
    email {$CADDY_ACME_EMAIL}
}

import /etc/caddy/Caddyfile.shared

# Public demo application
https://{$DOMAIN} {
    # Automatic HTTPS - Caddy handles certificate issuance and renewal
    # No tls directive needed for default ACME behavior

    # This line will be uncommented by ./docker-entrypoint.sh to enable custom certificates
    # when CADDY_CERTS_HOST_PATH is set -- it should point to mount inside docker container
    # tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    # The files hostname shares this origin IP, so the OCI firewall cannot
    # restrict port 443 to Cloudflare. Reject direct admin requests here.
    # Keep these ranges in sync with https://www.cloudflare.com/ips/.
    @directAdmin {
        path /staff-admin /staff-admin/*
        not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }

    # Check the per-IP cap first so rejected crawler requests do not consume
    # the shared allowance needed by other visitors.
    route {
        respond @directAdmin "Forbidden" 403
        rate_limit {
            zone admin_per_ip {
                match {
                    path /staff-admin /staff-admin/*
                }
                # Cloudflare's visitor IP is safe to use after @directAdmin
                # rejects requests that could forge this header directly.
                key {header.Cf-Connecting-Ip}
                events 30
                window 1m
            }
        }
        rate_limit {
            zone admin_total {
                match {
                    path /staff-admin /staff-admin/*
                }
                key admin
                events 120
                window 1m
            }
        }
    }

    handle /robots.txt {
        root * /etc/caddy
        file_server
    }

    import app_routes
}

# File server
https://{$FILES_DOMAIN} {
    # Automatic HTTPS

    # This line will be uncommented by ./docker-entrypoint.sh to enable custom certificates
    # when CADDY_CERTS_HOST_PATH is set -- it should point to mount inside docker container
    # tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    import file_routes
}
