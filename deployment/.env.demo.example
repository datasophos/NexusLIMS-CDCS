# ============================================================================
# NexusLIMS-CDCS Public Demo Environment Configuration
# ============================================================================
# Copy to .env and fill in secrets before deploying.
#
# Generate secrets with:
#   python3 -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
#
# ----------------------------------------------------------------------------
# Project Identification
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nexuslims_demo

IMAGE_VERSION=latest

# ----------------------------------------------------------------------------
# Application URLs & Domains
# ----------------------------------------------------------------------------
DOMAIN=nexuslims-demo.datasophos.co
FILES_DOMAIN=files.nexuslims-demo.datasophos.co

SERVER_URI=https://${DOMAIN}
ALLOWED_HOSTS=${DOMAIN}
CSRF_TRUSTED_ORIGINS=https://${DOMAIN}

# ----------------------------------------------------------------------------
# Django Configuration
# ----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.demo_settings

# REQUIRED: Generate a secure random key
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_token_urlsafe_50

DJANGO_DEBUG=False

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_DB=nexuslims
POSTGRES_USER=nexuslims
# REQUIRED: Generate a secure random password
POSTGRES_PASS=CHANGE_ME_generate_with_token_urlsafe_32
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5532

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_VERSION=8
# REQUIRED: Generate a secure random password
REDIS_PASS=CHANGE_ME_generate_with_token_urlsafe_32
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6479

# ----------------------------------------------------------------------------
# Caddy Configuration
# ----------------------------------------------------------------------------
CADDYFILE=Caddyfile.prod
CADDY_ACME_EMAIL=admin@datasophos.co

# ----------------------------------------------------------------------------
# Backup / Timezone
# ----------------------------------------------------------------------------
TZ=America/New_York

# ----------------------------------------------------------------------------
# File Serving Configuration (demo fixtures)
# ----------------------------------------------------------------------------
NX_DATA_PATH=/srv/nx-data
NX_INSTRUMENT_DATA_PATH=/srv/nx-instrument-data

# docker-compose.demo.yml mounts these from deployment/fixtures/demo_data/
# (no need to set host paths here - the compose override handles it)

# ----------------------------------------------------------------------------
# CA Bundle for outbound HTTPS from within the container
# ----------------------------------------------------------------------------
# OCI / Let's Encrypt: use the system bundle
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Local dev with Caddy local CA: comment the two lines above and uncomment:
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/caddy-root-ca.crt
# CURL_CA_BUNDLE=/etc/ssl/certs/caddy-root-ca.crt

# ----------------------------------------------------------------------------
# XSLT Configuration
# ----------------------------------------------------------------------------
XSLT_DATASET_BASE_URL=https://${FILES_DOMAIN}/instrument-data
XSLT_PREVIEW_BASE_URL=https://${FILES_DOMAIN}/data
